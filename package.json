{
  "name": "my-english-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list",
    "db:dry-run": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.json\" \"*.md\" && npm run format:sql",
    "format:sql": "find supabase -type f -name '*.sql' -print0 | xargs -0 -n 1 sql-formatter --language postgresql --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.json\" \"*.md\" && node scripts/check-sql-format.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0",
    "typescript": "^5.7.3"
  }
}
